# 서원대학교 e-campus 로그인에 사용하는 학번 또는 아이디입니다.
SEOWON_ID=your_id

# 서원대학교 e-campus 로그인에 사용하는 비밀번호입니다.
SEOWON_PASSWORD=your_password

# [성능 최적화] 영상 다운로드 버퍼 크기 설정 (단위: KB, 기본값: 1024 = 1MB)
# 고속 인터넷 환경에서는 4096(4MB) 이상으로 설정을 권장합니다.
# 값이 클수록 대용량 파일 다운로드 시 I/O 병목이 줄어들어 속도가 향상될 수 있습니다.
DOWNLOAD_HIGH_WATER_MARK=1024
